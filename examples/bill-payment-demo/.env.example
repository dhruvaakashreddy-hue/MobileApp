# Copy this file to `.env` and paste your Razorpay TEST keys.
# Dashboard -> Settings -> API Keys -> Generate Test Key
#
# Test mode never moves real money. Use it for everything until you are ready
# to go live.

# Public. Safe to send to the browser — Checkout needs it.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# SECRET. Server only. Never import this into client code, never commit it.
# Anyone with this key can create and refund payments on your account.
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

PORT=5055
