# Copy to .env for local development. .env is gitignored. In production, set these on the host.
# Never commit real values, and never put a secret key in a VITE_ variable: those reach the browser.

# Core. The database and the app secrets are required in production.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/bizzar_dev
BB_APP_SECRET=
BB_PUBLIC_ORIGIN=http://localhost:5173
BB_CRON_SECRET=

# Brand, money and time. These are the India launch defaults.
BB_CURRENCY=INR
BB_LOCALE=en-IN
BB_TIME_ZONE=Asia/Kolkata
BB_SHIPPING_COUNTRIES=IN

# Timing.
BB_HOLD_SECONDS=120
BB_PAYMENT_GRACE_SECONDS=600
BB_WORKER_INTERVAL_MS=5000

# Payments, Razorpay. Start in test mode: test keys begin with rzp_test_.
BB_PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email. Development writes codes to .data/outbox. Production uses resend.
EMAIL_PROVIDER=dev-outbox
EMAIL_FROM=Bizzar Buzzar <hello@example.com>
RESEND_API_KEY=

# Browser alerts (Web Push with VAPID keys). Generate the pair with the web-push CLI.
BB_VAPID_PUBLIC_KEY=
BB_VAPID_PRIVATE_KEY=
BB_VAPID_SUBJECT=mailto:hello@example.com

# Browser build flags. VITE_BB_PREVIEW=true adds the concept preview to a staging build. Leave it unset in production.
VITE_BB_PREVIEW=
