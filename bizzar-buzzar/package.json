{
  "name": "bizzar-buzzar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/reset.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "admin:grant": "node --env-file-if-exists=.env scripts/grant-admin.ts",
    "worker": "node --env-file-if-exists=.env scripts/worker.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
