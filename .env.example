# ========================================
# Supabase Configuration (REQUIRED)
# ========================================
# Get these from: https://supabase.com/dashboard/project/[your-project]/settings/api

# PUBLIC - Safe to expose in frontend
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SECRET - Never expose these to frontend
# Use only in Edge Functions and backend
SUPABASE_SERVICE_ROLE_KEY=sb_service_...

# ========================================
# Email Configuration (OPTIONAL)
# ========================================
# Supabase uses default email sender: noreply@{project}.supabase.co
# Optional: Set custom email sender if using custom domain
# EXPO_PUBLIC_EMAIL_FROM=noreply@crushapp.com

# ========================================
# Razorpay Configuration (OPTIONAL)
# ========================================
# Get from: https://dashboard.razorpay.com/app/settings/api-keys

EXPO_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_SECRET=

# ========================================
# Database Configuration (INTERNAL)
# ========================================
# Used by supabase CLI
SUPABASE_DB_PASSWORD=
