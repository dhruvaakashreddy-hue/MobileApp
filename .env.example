# Copy to .env and fill in. .env is gitignored — never commit real values.

# ─── Mobile app (bundled into the build, so PUBLIC by definition) ───────────
# Only ever put publishable, non-secret values here.
#
# The deployed subscription API. Setting this is what switches the app from the
# free development unlock to real Razorpay payments — nothing else to change.
# Leave it empty and the paywall shows a "developer build" warning instead.
VITE_API_BASE_URL=

# ─── Server only (api/) — set these on your hosting platform, NOT here ──────
# Listed for reference. The key secret must never reach the app bundle.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Where Razorpay Checkout sends the customer when payment succeeds or is
# abandoned. These are the app's own deep links, already registered in
# AndroidManifest.xml and Info.plist.
APP_RETURN_URL=nudgeapp://payment-success
APP_CANCEL_URL=nudgeapp://payment-cancelled

# The API's own public URL, used to build the checkout link. Optional: it is
# inferred from the request host when unset, which is right on most hosts.
PUBLIC_API_BASE_URL=

# Who has paid. WITHOUT THESE THE STORE IS IN-MEMORY and every restart forgets
# your paying subscribers. Any Upstash-compatible Redis REST endpoint works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated CORS allow-list for the API, e.g.
# capacitor://localhost,http://localhost,http://localhost:5173
# Unset allows any origin, which is fine locally and sloppy in production.
ALLOWED_ORIGINS=
