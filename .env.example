# Copy to .env and fill in. .env is gitignored — never commit real values.

# ─── Mobile app (bundled into the build, so PUBLIC by definition) ───────────
# Only ever put publishable, non-secret values here.
VITE_API_BASE_URL=

# ─── Server only (api/) — set these on your hosting platform, NOT here ──────
# Listed for reference. The key secret must never reach the app bundle.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
APP_RETURN_URL=nudgeapp://payment-success
