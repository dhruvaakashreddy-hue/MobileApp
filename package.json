{
  "name": "crush-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "CRUSH - 18+ College Dating App MVP",
  "workspaces": [
    "apps/mobile",
    "apps/admin",
    "packages/types",
    "packages/ui",
    "packages/config"
  ],
  "scripts": {
    "dev:mobile": "cd apps/mobile && npm run dev",
    "dev:admin": "cd apps/admin && npm run dev",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write .",
    "db:migrate": "cd supabase && supabase migration create",
    "db:push": "cd supabase && supabase db push"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
